# ╔═════════════════════════════════════════════════════════════╗
# ║        Grade Uploader — Notas Parciales UNED                ║
# ║        Archivo de configuración de credenciales              ║
# ╚═════════════════════════════════════════════════════════════╝
#
# INSTRUCCIONES:
#   1. Copiá este archivo como ".env" (sin el .example)
#   2. Completá los valores de abajo
#   3. NUNCA subas el archivo .env a Git (ya está en .gitignore)
#
# Para instrucciones detalladas, consultá el README.md

# ─── Parte 1: Credenciales NTLM ──────────────────────────────
# Es el mismo usuario y contraseña que usás para entrar al
# Entorno de Funcionarios UNED (https://entornofuncionarios.uned.ac.cr/).
#
# IMPORTANTE: el usuario es SOLO el nombre, sin @uned.ac.cr
# Ejemplo: si tu correo es jperez@uned.ac.cr → NP_NTLM_USER=jperez

NP_NTLM_USER=
NP_NTLM_PASSWORD=

# ─── Parte 2: Cookies de sesión ──────────────────────────────
# Estas cookies se obtienen del navegador DESPUÉS de iniciar sesión
# en https://produccion.uned.ac.cr/notasparciales/Formularios/CapturaNotas.aspx
#
# Cómo obtenerlas:
#   1. Iniciá sesión en la página de Captura de Notas (en el navegador)
#   2. Presioná F12 para abrir Herramientas de Desarrollador
#   3. Navegá a:
#      - Chrome/Edge: Application → Cookies → produccion.uned.ac.cr
#      - Firefox:     Almacenamiento → Cookies → produccion.uned.ac.cr
#   4. Copiá los 3 valores de abajo
#
# ⚠️ Las cookies EXPIRAN tras ~20 min de inactividad.
#    Si el script falla, recargá la página (F5) y copiá cookies nuevas.

NP_COOKIE_ASPNET_SESSIONID=
NP_COOKIE_UZMX=
NP_COOKIE_UZMXJ=

# ─── Opcional ─────────────────────────────────────────────────
# Datos del usuario funcionario (no siempre necesarios)
# NP_USUARIO_CEDULA=
# NP_USUARIO_ROLE=14
